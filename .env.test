# lab-management-system-laravel — phpunit 期覆盖
#
# L4 测试期 Laravel 按 APP_ENV 加载 .env.test（phpunit.xml APP_ENV=test）→
# key 集合与 .env.example 一致（L0.5 门）。直连库由本文件 PG_DATABASE 决定：
# 测试链 = lab_test（家族三库分层，multi-repo-family.md §6.2）。
# 不碰库的测试（parity/health/smoke）走 Laravel 惰性连接，天然零 PG 依赖。

# —— Server ——
SERVER_PORT=5210

# —— Database（lab_test 数据库, 全家族统一 PG_* 五件套） ——
DB_CONNECTION=pgsql
PG_HOST=127.0.0.1
PG_PORT=54321
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=lab_test

# —— JWT (HS256, ≥32B 硬约束) ——
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=lab-management-system
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# —— saas OAuth (直连 saas IdP, ADR-0009; 恒真链) ——
LAB_SAAS_BASE_URL=http://localhost:5101
LAB_SSO_LOGIN_URL=http://localhost:5101
LAB_SAAS_CLIENT_ID=lab-management
LAB_SAAS_CLIENT_SECRET=lab-management-secret
LAB_SAAS_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
LAB_SSO_CALLBACK_REDIRECT=http://localhost:5202/login
LAB_SAAS_SERVICE_USER=alice
LAB_SAAS_SERVICE_PASSWORD=dev123456
LAB_SAAS_SERVICE_CLIENT_ID=lab-management

# octane worker boot 期解析 encrypter（缺则 MissingAppKeyException）；测试面不消费。
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
