# lab-management-system-laravel — 开发期环境变量模板
#
# L0.5 env 一致性门管理三件套：.env.example（dev）/.env.test（phpunit）/.env（本地）
# key 集合严格相等；secret 值由 deploy 注入（不 commit 真密钥）。
# 键名镜像 lab-management-system-rails 家族口径（PG_* 五件套 + JWT + SERVER_PORT
# + LAB_SAAS_* OAuth 九件）；laravel 额外需要 DB_CONNECTION 选连接
# （映射进 config/database.php，无默认值兜底）。
# L4.db.* 真跑需 dev 机器配真 PG（127.0.0.1:54321 + lab_dev/lab_test 库）。

# —— Server ——
# fail-fast：缺失/非法值 serve.php 即退出，禁止默认值兜底（suite-hard-rules §1）。
# 端口 X10 槽：saas-identity-platform-laravel = 5110 ｜ lab-management-system-laravel = 5210
SERVER_PORT=5210

# —— Database（lab_dev 数据库, 全家族统一 PG_* 五件套） ——
# DB_CONNECTION 选 config/database.php 里的连接；PG_* 是该连接的真实来源。
# dev/test=本机 127.0.0.1:54321（docs/families/lab.md 值表）；prod=远程 dev 机。
DB_CONNECTION=pgsql
PG_HOST=127.0.0.1
PG_PORT=54321
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=lab_dev

# —— JWT (HS256, ≥32B 硬约束, 全家族镜像同一 JWT_SIGNING_KEY，rails .env.example 同名) ——
# lab 自签 HS256 access/refresh token；SSO 链路 lab refresh token 内嵌 saas refresh token。
# iss 值镜像 rails .env.example（终审 I-2 同语义：verify_iss/verify_aud 在实装任务对齐）。
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_ISSUER=lab-management-system
JWT_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# —— saas OAuth (直连 saas IdP, ADR-0009; 恒真链) ——
LAB_SAAS_BASE_URL=http://localhost:5101
LAB_SSO_LOGIN_URL=http://localhost:5101
LAB_SAAS_CLIENT_ID=lab-management
LAB_SAAS_CLIENT_SECRET=lab-management-secret
LAB_SAAS_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
LAB_SSO_CALLBACK_REDIRECT=http://localhost:5202/login
LAB_SAAS_SERVICE_USER=alice
LAB_SAAS_SERVICE_PASSWORD=dev123456
LAB_SAAS_SERVICE_CLIENT_ID=lab-management
