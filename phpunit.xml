<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Contracts">
            <directory>tests/Contracts</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>routes</directory>
        </include>
    </source>
    <php>
        <!-- 测试期固定环境：APP_ENV=test → Laravel 加载 .env.test（PG 键直连 lab_test；
             骨架期 sqlite :memory: 两行已删——lab 24 表 DB-First，测试链走真 PG）。
             不碰库的测试（parity/health/smoke）靠惰性连接天然零 PG 依赖；探活路由
             不挂 web 中间件组故无 session/cookie，无 APP_KEY 依赖。 -->
        <env name="APP_ENV" value="test"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
    <extensions>
        <!-- trace 适配器：仅 TRACE_MAP=1（suite trace_env 注入）时写 .state/trace.json -->
        <bootstrap class="Harness\HarnessTraceExtension"/>
    </extensions>
</phpunit>
